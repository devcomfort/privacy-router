Intent evidence: Explain Python; no delivery or contact inclusion.
Output: {"intent_consistent":true,"masking_preserves_task":true,"masking_reason":"The public Python subject remains after the private contact is masked.","records":[{"category":"EMAIL_ADDRESS","span":"minjun@company.example","confidence":0.99,"confidentiality":{"value":"private","reason":"Personal contact attributed to the speaker."},"necessity":{"value":"optional","reason":"Reference contact is unused for the requested explanation."}},{"category":"PROGRAMMING_LANGUAGE","span":"Python","confidence":0.99,"confidentiality":{"value":"public","reason":"Known public programming language."},"necessity":{"value":"required","reason":"The requested explanation is specifically about this language."}}]}

