Output: {"intent_consistent":true,"masking_preserves_task":false,"masking_reason":"Masking the unresolved plan identity removes the requested subject.","records":[{"category":"PROJECT_NAME","span":"Orion","confidence":0.99,"confidentiality":{"value":null,"reason":"The source does not establish whether this plan is published or internal."},"necessity":{"value":"required","reason":"Identifies the specific plan requested for explanation."}}]}

