    {
      "id": "src_pipeline_pipeline_trust_text",
      "type": "text",
      "x": 98,
      "y": 5878,
      "width": 864,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 771766134,
      "version": 1,
      "versionNonce": 157873380,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "외부 신뢰 경계(trust boundary)\n이 선을 넘은 정보는 외부 시스템의 통제 아래 놓입니다.\n따라서 선을 넘기 직전의 실제 전송 내용을 반드시 검사합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "외부 신뢰 경계(trust boundary)\n이 선을 넘은 정보는 외부 시스템의 통제 아래 놓입니다.\n따라서 선을 넘기 직전의 실제 전송 내용을 반드시 검사합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_trust_text"
      }
    },
