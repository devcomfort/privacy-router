    {
      "id": "src_pipeline_pipeline_reading_text",
      "type": "text",
      "x": 726,
      "y": 6871,
      "width": 568,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1566427249,
      "version": 1,
      "versionNonce": 513866039,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장을 읽는 순서\n먼저 위쪽의 모델 입력 흐름을 왼쪽에서 오른쪽으로 읽습니다.\n빨간 외부 신뢰 경계에서 실제 전송 내용을 확인합니다.\n그다음 아래쪽의 평가 전용 흐름에서 누출 측정과 오류 진단\n방법을 확인합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장을 읽는 순서\n먼저 위쪽의 모델 입력 흐름을 왼쪽에서 오른쪽으로 읽습니다.\n빨간 외부 신뢰 경계에서 실제 전송 내용을 확인합니다.\n그다음 아래쪽의 평가 전용 흐름에서 누출 측정과 오류 진단\n방법을 확인합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_reading_text"
      }
    },
    {
