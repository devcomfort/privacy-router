    {
      "id": "src_pipeline_pipeline_legend_text",
      "type": "text",
      "x": 1354,
      "y": 6871,
      "width": 568,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 506837687,
      "version": 1,
      "versionNonce": 911952565,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "색과 근거 문서\n파랑은 사실과 구조, 보라는 방법과 시스템, 초록은 검증\n근거, 주황은 계획, 빨강은 진행을 막는 조건과 외부 경계를\n뜻합니다.\n근거 문서는 FINAL_PROPOSAL과\nEXPERIMENT_PLAN이며, 누출은 원문·의미\n단위·추론 가능 정보의 세 수준으로 나누고 작업 성공도는 두\n가지 정의로 측정합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "색과 근거 문서\n파랑은 사실과 구조, 보라는 방법과 시스템, 초록은 검증\n근거, 주황은 계획, 빨강은 진행을 막는 조건과 외부 경계를\n뜻합니다.\n근거 문서는 FINAL_PROPOSAL과\nEXPERIMENT_PLAN이며, 누출은 원문·의미\n단위·추론 가능 정보의 세 수준으로 나누고 작업 성공도는 두\n가지 정의로 측정합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_legend_text"
      }
