    {
      "id": "src_story_story_intent_text",
      "type": "text",
      "x": 98,
      "y": 3609,
      "width": 568,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 486231374,
      "version": 1,
      "versionNonce": 373949930,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장의 목적\n연구 문제에서 기여 후보, 검증 순서, 투고 전략까지 한\n흐름으로 이해하도록 구성했습니다.\n벤치마크 기여와 Privacy Router 구현을 분리해,\n구현 자체를 새로운 알고리즘으로 오해하지 않게 합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장의 목적\n연구 문제에서 기여 후보, 검증 순서, 투고 전략까지 한\n흐름으로 이해하도록 구성했습니다.\n벤치마크 기여와 Privacy Router 구현을 분리해,\n구현 자체를 새로운 알고리즘으로 오해하지 않게 합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_intent_text"
      }
    },
