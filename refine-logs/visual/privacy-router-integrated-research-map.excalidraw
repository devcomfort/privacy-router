    },
    {
      "id": "integrated_gates_intro_text",
      "type": "text",
      "x": 98,
      "y": 13096,
      "width": 1824,
      "height": 23,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1360551947,
      "version": 1,
      "versionNonce": 617964276,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "각 카드는 이 단계가 필요한 이유, 통과 기준, 남겨야 할 산출물, 지금 할 일을 함께 설명합니다. 통과 기준을 충족하기 전에는 계획을 결과로 쓰거나 다음 단계의 성능 주장을 하지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "각 카드는 이 단계가 필요한 이유, 통과 기준, 남겨야 할 산출물, 지금 할 일을 함께 설명합니다. 통과 기준을 충족하기 전에는 계획을 결과로 쓰거나 다음 단계의 성능 주장을 하지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "integrated_gate_g0",
      "type": "rectangle",
      "x": 120,
      "y": 13212,
      "width": 1780,
      "height": 205,
      "angle": 0,
      "strokeColor": "#ef4444",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
