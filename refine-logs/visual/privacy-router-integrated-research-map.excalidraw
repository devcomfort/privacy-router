      "seed": 215323007,
      "version": 1,
      "versionNonce": 773109542,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C3에 필요한 실험은 E5입니다.\n내용 변환 효과와 전송 경로 선택 효과를 함께 평가하고, 필요하면 두 효과를 분리해\n비교합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C3에 필요한 실험은 E5입니다.\n내용 변환 효과와 전송 경로 선택 효과를 함께 평가하고, 필요하면 두 효과를 분리해\n비교합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_exp_C3_text"
      }
    },
