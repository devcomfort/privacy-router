      "seed": 2120111394,
      "version": 1,
      "versionNonce": 1570024330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "현재 G0~G6은 모두 BLOCKED입니다.\n앞 단계를 통과하기 전에는 뒤 단계를 시작하지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "현재 G0~G6은 모두 BLOCKED입니다.\n앞 단계를 통과하기 전에는 뒤 단계를 시작하지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "integrated_gates_intro",
      "type": "rectangle",
