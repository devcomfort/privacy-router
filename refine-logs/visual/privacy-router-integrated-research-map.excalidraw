    {
      "id": "src_story_story_action_1_text",
      "type": "text",
      "x": 98,
      "y": 3209,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
