      "index": null,
      "seed": 935332360,
      "version": 1,
      "versionNonce": 2463552,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "외부 전송 후보(candidate egress)\n모델이나 도구 제공자에게 보내기 직전의 내용입니다. 사용자 맥락, 보내려는 본문, 수신자,\n사용 목적, 적용할 정책을 함께 봅니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "외부 전송 후보(candidate egress)\n모델이나 도구 제공자에게 보내기 직전의 내용입니다. 사용자 맥락, 보내려는 본문, 수신자,\n사용 목적, 적용할 정책을 함께 봅니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "integrated_term_0_1",
