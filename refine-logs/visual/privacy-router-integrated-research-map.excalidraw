      "versionNonce": 142477330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G4 — 실험 조건 고정\n현재 상태는 BLOCKED입니다.\n정책, 데이터 형식, 프롬프트, 모델, 임계값, 테스트의 해시를 기록해 실험 중 조건이 바뀌지\n않도록 해야 합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G4 — 실험 조건 고정\n현재 상태는 BLOCKED입니다.\n정책, 데이터 형식, 프롬프트, 모델, 임계값, 테스트의 해시를 기록해 실험 중 조건이 바뀌지\n않도록 해야 합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_gate_4_text"
      }
