    {
      "id": "src_pipeline_pipeline_gold_text",
      "type": "text",
      "x": 98,
      "y": 6174,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 977610020,
      "version": 1,
      "versionNonce": 1372369516,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "평가용 정답 표시\n문맥상 보호해야 할 정보의 정확한 범위, 의미 단위, 원문 문자 위치와 바이트 위치를\n기록합니다.\n이 정보는 사후 평가에만 사용하며 모델 입력에는 넣지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "평가용 정답 표시\n문맥상 보호해야 할 정보의 정확한 범위, 의미 단위, 원문 문자 위치와 바이트 위치를\n기록합니다.\n이 정보는 사후 평가에만 사용하며 모델 입력에는 넣지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_gold_text"
      }
    },
