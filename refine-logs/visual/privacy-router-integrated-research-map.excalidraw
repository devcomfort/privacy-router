    {
      "id": "src_claim_claim_exp_C3_text",
      "type": "text",
      "x": 1038,
      "y": 9644,
      "width": 864,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
