    {
      "id": "integrated_gate_g3_text",
      "type": "text",
      "x": 138,
      "y": 13905,
      "width": 1744,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1821604273,
      "version": 1,
      "versionNonce": 1677070477,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G3 — 평가기 정확성 확인\n목적: 채점기가 원문·의미 단위·추론 가능 누출과 작업 성공도를 올바르게 계산하는지 확인합니다.\n통과 조건: 정답을 미리 아는 모든 시험 사례가 손으로 계산한 결과와 일치해야 합니다.\n필요한 산출물: 시험 사례, 손 계산표, 자동 평가 결과 비교표입니다.\n지금 할 일: 각 지표의 경계 사례와 실패 사례를 먼저 만듭니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G3 — 평가기 정확성 확인\n목적: 채점기가 원문·의미 단위·추론 가능 누출과 작업 성공도를 올바르게 계산하는지 확인합니다.\n통과 조건: 정답을 미리 아는 모든 시험 사례가 손으로 계산한 결과와 일치해야 합니다.\n필요한 산출물: 시험 사례, 손 계산표, 자동 평가 결과 비교표입니다.\n지금 할 일: 각 지표의 경계 사례와 실패 사례를 먼저 만듭니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
