    {
      "id": "src_claim_claim_intent_text",
      "type": "text",
      "x": 98,
      "y": 12610,
      "width": 568,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
