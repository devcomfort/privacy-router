    },
    {
      "id": "src_story_story_verdict_text",
      "type": "text",
      "x": 1050,
      "y": 2002,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 903748623,
      "version": 1,
      "versionNonce": 2077462568,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "8. 현재 결정\n지금은 WP0와 80–120개 항목의 예비 검증만 진행합니다.\nG0·G1과 정책·데이터 형식 고정 조건을 통과하기 전에는 새로움, 성능 우월성, 사전등록,\n전체 벤치마크 제작을 주장하거나 시작하지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8. 현재 결정\n지금은 WP0와 80–120개 항목의 예비 검증만 진행합니다.\nG0·G1과 정책·데이터 형식 고정 조건을 통과하기 전에는 새로움, 성능 우월성, 사전등록,\n전체 벤치마크 제작을 주장하거나 시작하지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_verdict_text"
      }
    },
