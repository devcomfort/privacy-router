    {
      "id": "src_pipeline_pipeline_serialized_text",
      "type": "text",
      "x": 188,
      "y": 5654,
      "width": 1644,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 893468842,
      "version": 1,
      "versionNonce": 1627769205,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "7. 실제 전송 내용\n요청이 네트워크 형식으로 변환된 뒤 실제로 모델이나 도구 제공자에게 전달되는 바이트를 기록합니다.\n민감 정보 누출은 내부 객체가 아니라 이 최종 전송 내용에서 판정합니다.\n헤더·도구 인자·숨은 필드에 정보가 남아 있으면 누출로 계산합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7. 실제 전송 내용\n요청이 네트워크 형식으로 변환된 뒤 실제로 모델이나 도구 제공자에게 전달되는 바이트를 기록합니다.\n민감 정보 누출은 내부 객체가 아니라 이 최종 전송 내용에서 판정합니다.\n헤더·도구 인자·숨은 필드에 정보가 남아 있으면 누출로 계산합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_serialized_text"
      }
    },
