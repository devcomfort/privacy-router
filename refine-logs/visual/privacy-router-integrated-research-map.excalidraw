    {
      "id": "src_pipeline_pipeline_reject_rule_text",
      "type": "text",
      "x": 1022,
      "y": 5878,
      "width": 900,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
