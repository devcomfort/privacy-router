    {
      "id": "src_pipeline_pipeline_scorer_text",
      "type": "text",
      "x": 98,
      "y": 6363,
      "width": 892,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
