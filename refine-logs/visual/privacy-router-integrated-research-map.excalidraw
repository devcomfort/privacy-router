      "index": null,
      "seed": 1903830189,
      "version": 1,
      "versionNonce": 1643899758,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "색과 근거 문서\n파랑은 논문 주장, 보라는 실험, 주황은 통과 기준, 빨강은\n근거 없음과 차단 상태, 초록은 실패 시 범위 축소안과 공통\n검증을 뜻합니다.\n근거 문서는 EXPERIMENT_PLAN,\nEXPERIMENT_TRACKER,\nPIPELINE_SUMMARY입니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "색과 근거 문서\n파랑은 논문 주장, 보라는 실험, 주황은 통과 기준, 빨강은\n근거 없음과 차단 상태, 초록은 실패 시 범위 축소안과 공통\n검증을 뜻합니다.\n근거 문서는 EXPERIMENT_PLAN,\nEXPERIMENT_TRACKER,\nPIPELINE_SUMMARY입니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
