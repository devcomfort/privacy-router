    {
      "id": "integrated_gate_g6_text",
      "type": "text",
      "x": 138,
      "y": 14580,
      "width": 1744,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1930190511,
      "version": 1,
      "versionNonce": 704149887,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G6 — 논문 제출 준비\n목적: 숫자뿐 아니라 사용성, 실패 양상, 재현 가능성을 함께 확인합니다.\n통과 조건: 사람의 작업 성공도 평가, 실패 사례 감사, 재현 가능한 산출물 설명을 완료해야 합니다.\n필요한 산출물: 사람 평가 결과, 실패 분석, 산출물 카드, 재현 절차입니다.\n지금 할 일: G5 결과가 확정된 뒤 논문 주장과 표를 결과에 맞게 제한합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G6 — 논문 제출 준비\n목적: 숫자뿐 아니라 사용성, 실패 양상, 재현 가능성을 함께 확인합니다.\n통과 조건: 사람의 작업 성공도 평가, 실패 사례 감사, 재현 가능한 산출물 설명을 완료해야 합니다.\n필요한 산출물: 사람 평가 결과, 실패 분석, 산출물 카드, 재현 절차입니다.\n지금 할 일: G5 결과가 확정된 뒤 논문 주장과 표를 결과에 맞게 제한합니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
