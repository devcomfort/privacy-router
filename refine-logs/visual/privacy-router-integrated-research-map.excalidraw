    {
      "id": "integrated_gates_status_text",
      "type": "text",
      "x": 1363,
      "y": 12952,
      "width": 559,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
