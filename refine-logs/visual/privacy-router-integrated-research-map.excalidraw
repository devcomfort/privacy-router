      "versionNonce": 630364384,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C3 — 누출 감소와 작업 성공도의 균형\n전체 시스템이 외부 정보 누출을 줄이면서도 사용자의 작업 성공도를 허용 가능한 범위 안에\n유지하는지를 묻습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C3 — 누출 감소와 작업 성공도의 균형\n전체 시스템이 외부 정보 누출을 줄이면서도 사용자의 작업 성공도를 허용 가능한 범위 안에\n유지하는지를 묻습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_c3_text"
      }
    },
