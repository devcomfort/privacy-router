      "locked": false
    },
    {
      "id": "integrated_complete_contribution_text",
      "type": "text",
      "x": 1050,
      "y": 208,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 388438425,
      "version": 1,
      "versionNonce": 647102498,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2. 검증하려는 기여 후보\n한 번에 한 조건만 바꾸는 통제 실험과 영어·한국어 쌍 문항을 만듭니다.\n정확한 문자 범위, 정책 준수, 실제 외부 누출, 작업 성공도를 함께 측정하는 벤치마크를\n검증합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. 검증하려는 기여 후보\n한 번에 한 조건만 바꾸는 통제 실험과 영어·한국어 쌍 문항을 만듭니다.\n정확한 문자 범위, 정책 준수, 실제 외부 누출, 작업 성공도를 함께 측정하는 벤치마크를\n검증합니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
