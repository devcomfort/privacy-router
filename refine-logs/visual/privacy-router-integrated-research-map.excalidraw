      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G1 — 현재 BLOCKED\n평가자 행동 일치도는 AC1≥0.67이고, 한 조건만 바꾼 문항의 타당성은 ≥90%여야\n합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G1 — 현재 BLOCKED\n평가자 행동 일치도는 AC1≥0.67이고, 한 조건만 바꾼 문항의 타당성은 ≥90%여야\n합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_g1_text"
      }
    },
