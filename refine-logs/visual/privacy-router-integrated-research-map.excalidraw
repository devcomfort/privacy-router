      "index": null,
      "seed": 1517779939,
      "version": 1,
      "versionNonce": 549958047,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C1에 필요한 실험은 E2-D와 E2-T입니다.\nE2-D는 탐지기들을 비교하고, E2-T는 문항 형태와 언어 조건을 포함해 같은 임계값에서\n결과를 비교합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C1에 필요한 실험은 E2-D와 E2-T입니다.\nE2-D는 탐지기들을 비교하고, E2-T는 문항 형태와 언어 조건을 포함해 같은 임계값에서\n결과를 비교합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_exp_C1_text"
      }
    },
