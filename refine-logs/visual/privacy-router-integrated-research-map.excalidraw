      "index": null,
      "seed": 1054158360,
      "version": 1,
      "versionNonce": 211944744,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "평가에만 쓰는 영역(EVALUATOR-ONLY) — 정답 데이터와 채점 과정은 모델 요청과 물리적으로 분리합니다.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "평가에만 쓰는 영역(EVALUATOR-ONLY) — 정답 데이터와 채점 과정은 모델 요청과 물리적으로 분리합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
