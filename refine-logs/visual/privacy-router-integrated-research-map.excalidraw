    {
      "id": "src_story_story_legend_text",
      "type": "text",
      "x": 1354,
      "y": 3609,
      "width": 568,
      "height": 158,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
