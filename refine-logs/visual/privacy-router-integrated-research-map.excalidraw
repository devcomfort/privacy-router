    {
      "id": "src_pipeline_pipeline_actions_text",
      "type": "text",
      "x": 1050,
      "y": 6174,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 123229061,
      "version": 1,
      "versionNonce": 1832720741,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "정답 정책 판단\n각 상황에서 선택해야 하는 대표 처리 방식, 허용 가능한 처리 방식의 집합, 수신자·사용 목적\n규칙을 기록합니다.\n시스템의 선택이 이 정답 집합에 속하는지 평가합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "정답 정책 판단\n각 상황에서 선택해야 하는 대표 처리 방식, 허용 가능한 처리 방식의 집합, 수신자·사용 목적\n규칙을 기록합니다.\n시스템의 선택이 이 정답 집합에 속하는지 평가합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_actions_text"
      }
    },
    {
