      "index": null,
      "seed": 2073621032,
      "version": 1,
      "versionNonce": 1882437652,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G0 — 선행연구·산출물 조사\n현재 상태는 BLOCKED입니다.\n관련 논문과 공개 산출물의 전문, 라이선스, 학회 정보를 조사해 동등한 벤치마크가 없음을\n확인해야 통과합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G0 — 선행연구·산출물 조사\n현재 상태는 BLOCKED입니다.\n관련 논문과 공개 산출물의 전문, 라이선스, 학회 정보를 조사해 동등한 벤치마크가 없음을\n확인해야 통과합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_gate_0_text"
      }
    },
