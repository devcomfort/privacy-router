    {
      "id": "src_story_story_reading_text",
      "type": "text",
      "x": 726,
      "y": 3609,
      "width": 568,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 45832535,
      "version": 1,
      "versionNonce": 1286028825,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장을 읽는 순서\n먼저 1번부터 8번까지 연구 논리를 따라갑니다.\n그다음 G0~G6에서 현재 진행을 막는 조건을 확인합니다.\n마지막으로 네 가지 즉시 행동을 실제 다음 작업으로\n사용합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장을 읽는 순서\n먼저 1번부터 8번까지 연구 논리를 따라갑니다.\n그다음 G0~G6에서 현재 진행을 막는 조건을 확인합니다.\n마지막으로 네 가지 즉시 행동을 실제 다음 작업으로\n사용합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_reading_text"
      }
    },
