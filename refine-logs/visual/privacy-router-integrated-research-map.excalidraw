    {
      "id": "src_story_story_action_3_text",
      "type": "text",
      "x": 98,
      "y": 3403,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1239788165,
      "version": 1,
      "versionNonce": 1780663044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3. 타당성 예비 검증\n20–30개 시나리오마다 조건을 두 가지로 바꾸고, 영어·한국어 버전을 만듭니다.\n계획한 규모는 20–30 scenarios × 2 variants × EN/KO =\n80–120 items이며, 이 작업이 G1 통과 여부를 결정합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. 타당성 예비 검증\n20–30개 시나리오마다 조건을 두 가지로 바꾸고, 영어·한국어 버전을 만듭니다.\n계획한 규모는 20–30 scenarios × 2 variants × EN/KO =\n80–120 items이며, 이 작업이 G1 통과 여부를 결정합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_action_3_text"
      }
    },
