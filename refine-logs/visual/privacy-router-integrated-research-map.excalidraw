    {
      "id": "src_story_story_status_text",
      "type": "text",
      "x": 1363,
      "y": 897,
      "width": 559,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1541717445,
      "version": 1,
      "versionNonce": 314952495,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "현재 판정은 GO_TO_PILOT (8/10)입니다.\n이는 80–120개 항목으로 예비 검증을 진행해도 된다는\n뜻입니다.\n논문 결과가 확립되었거나 전체 벤치마크 제작이 승인되었다는\n뜻은 아닙니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "현재 판정은 GO_TO_PILOT (8/10)입니다.\n이는 80–120개 항목으로 예비 검증을 진행해도 된다는\n뜻입니다.\n논문 결과가 확립되었거나 전체 벤치마크 제작이 승인되었다는\n뜻은 아닙니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_status_text"
      }
    },
