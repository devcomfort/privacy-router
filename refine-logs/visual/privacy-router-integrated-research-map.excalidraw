    {
      "id": "src_story_story_venue_text",
      "type": "text",
      "x": 98,
      "y": 2002,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 502597129,
      "version": 1,
      "versionNonce": 368387250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "7. 투고 전략\n현재 연구 형태에는 ACL 또는 EMNLP Findings가 가장 적합한 1차 목표입니다.\nPETS는 정책과 위협 모델, 실무 타당성이 충분히 강화될 때만 조건부로 고려합니다.\n현재 계획만으로는 USENIX Security나 IEEE S&P 투고를 정당화하기 어렵습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7. 투고 전략\n현재 연구 형태에는 ACL 또는 EMNLP Findings가 가장 적합한 1차 목표입니다.\nPETS는 정책과 위협 모델, 실무 타당성이 충분히 강화될 때만 조건부로 고려합니다.\n현재 계획만으로는 USENIX Security나 IEEE S&P 투고를 정당화하기 어렵습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_venue_text"
      }
    },
    {
      "id": "story_story_verdict_text_card",
      "type": "rectangle",
      "x": 1032,
