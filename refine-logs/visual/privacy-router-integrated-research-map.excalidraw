    {
      "id": "integrated_gate_g4_text",
      "type": "text",
      "x": 138,
      "y": 14130,
      "width": 1744,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
