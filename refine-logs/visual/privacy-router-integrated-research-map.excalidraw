    {
      "id": "src_story_story_validation_text",
      "type": "text",
      "x": 1050,
      "y": 1768,
      "width": 892,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1515480181,
      "version": 1,
      "versionNonce": 1538776213,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "6. 검증 순서\n먼저 같은 연구 산출물이 이미 있는지 조사하고, 다음으로 소규모 예비 검증의 타당성을\n확인합니다.\n그 뒤 데이터셋과 평가기를 고정한 후 본 실험을 수행합니다.\n계획이나 가설을 실험 결과처럼 쓰지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. 검증 순서\n먼저 같은 연구 산출물이 이미 있는지 조사하고, 다음으로 소규모 예비 검증의 타당성을\n확인합니다.\n그 뒤 데이터셋과 평가기를 고정한 후 본 실험을 수행합니다.\n계획이나 가설을 실험 결과처럼 쓰지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_validation_text"
      }
    },
