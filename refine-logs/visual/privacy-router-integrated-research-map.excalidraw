      "index": null,
      "seed": 820416825,
      "version": 1,
      "versionNonce": 1445341749,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "채점기\n외부로 실제 전송된 내용과 평가용 정답을 비교해 누출을 계산합니다.\n같은 전송 경로에서 보호 처리 뒤 작업 성공도도 연결해, 안전성과 사용성을 함께 평가합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "채점기\n외부로 실제 전송된 내용과 평가용 정답을 비교해 누출을 계산합니다.\n같은 전송 경로에서 보호 처리 뒤 작업 성공도도 연결해, 안전성과 사용성을 함께 평가합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_scorer_text"
      }
    },
