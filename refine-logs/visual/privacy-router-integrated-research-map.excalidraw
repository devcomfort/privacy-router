      "versionNonce": 2016270296,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "E0-F — 전체 데이터셋 검증\n시나리오 계층과 학습·개발·평가 분할이 적절한지 확인합니다.\n문항이 현실적이고 정답이나 분할 정보가 모델 입력에 새어\n나오지 않는지 검사합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E0-F — 전체 데이터셋 검증\n시나리오 계층과 학습·개발·평가 분할이 적절한지 확인합니다.\n문항이 현실적이고 정답이나 분할 정보가 모델 입력에 새어\n나오지 않는지 검사합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_e0f_text"
      }
