      "index": null,
      "seed": 720392367,
      "version": 1,
      "versionNonce": 925282881,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "E0-P — 예비 검증의 타당성\n평가자가 사실 조건에 얼마나 일치하는지 확인하고, 한 조건만\n바꾼 문항이 의도대로 작동하는지 검사합니다.\n이 검증이 실패하면 본 데이터셋 제작으로 넘어가지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E0-P — 예비 검증의 타당성\n평가자가 사실 조건에 얼마나 일치하는지 확인하고, 한 조건만\n바꾼 문항이 의도대로 작동하는지 검사합니다.\n이 검증이 실패하면 본 데이터셋 제작으로 넘어가지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
