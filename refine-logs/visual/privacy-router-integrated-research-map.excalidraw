    {
      "id": "integrated_complete_evidence_text",
      "type": "text",
      "x": 98,
      "y": 402,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1631234754,
      "version": 1,
      "versionNonce": 613862535,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3. 현재 확보한 근거\n설계와 단위 테스트는 준비되었지만 논문 성능 근거는 아닙니다.\n선행연구 조사 G0과 예비 검증 G1을 통과한 뒤에만 데이터셋을 고정하고 본 실험 E2~E7을\n진행할 수 있습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. 현재 확보한 근거\n설계와 단위 테스트는 준비되었지만 논문 성능 근거는 아닙니다.\n선행연구 조사 G0과 예비 검증 G1을 통과한 뒤에만 데이터셋을 고정하고 본 실험 E2~E7을\n진행할 수 있습니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
