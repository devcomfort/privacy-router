      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 917787737,
      "version": 1,
      "versionNonce": 322577722,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "색과 근거 문서\n파랑은 사실과 구조, 보라는 방법과 시스템, 초록은 검증\n근거와 허용된 후속 조치, 주황은 계획, 빨강은 진행을 막는\n조건을 뜻합니다.\n근거 문서는 FINAL_PROPOSAL,\nREVIEW_SUMMARY, EXPERIMENT_TRACKE\nR(2026-07-22)입니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "색과 근거 문서\n파랑은 사실과 구조, 보라는 방법과 시스템, 초록은 검증\n근거와 허용된 후속 조치, 주황은 계획, 빨강은 진행을 막는\n조건을 뜻합니다.\n근거 문서는 FINAL_PROPOSAL,\nREVIEW_SUMMARY, EXPERIMENT_TRACKE\nR(2026-07-22)입니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_legend_text"
