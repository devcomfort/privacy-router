    {
      "id": "src_claim_claim_legend_text",
      "type": "text",
      "x": 1354,
      "y": 12610,
      "width": 568,
      "height": 158,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
