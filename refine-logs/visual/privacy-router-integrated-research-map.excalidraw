      "seed": 2126168241,
      "version": 1,
      "versionNonce": 9576903,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장의 목적\n각 논문 주장을 실험, 통과 기준, 현재 근거, 실패 시\n범위 축소안과 직접 연결합니다.\n계획이나 가설을 이미 확인된 결과로 오인하지 않게 합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장의 목적\n각 논문 주장을 실험, 통과 기준, 현재 근거, 실패 시\n범위 축소안과 직접 연결합니다.\n계획이나 가설을 이미 확인된 결과로 오인하지 않게 합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_intent_text"
      }
    },
