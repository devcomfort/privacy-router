    {
      "id": "src_claim_claim_c1_text",
      "type": "text",
      "x": 118,
      "y": 8452,
      "width": 864,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 364636360,
      "version": 1,
      "versionNonce": 1749813050,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C1 — 문맥을 이용한 민감 정보 탐지\n개인 식별 정보가 아닌 조직·연구 기밀도 문맥을 이용하면 더 잘 찾을 수 있는지를\n묻습니다.\n핵심 평가지표는 보호해야 할 정보를 놓치지 않고 찾는 재현율입니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C1 — 문맥을 이용한 민감 정보 탐지\n개인 식별 정보가 아닌 조직·연구 기밀도 문맥을 이용하면 더 잘 찾을 수 있는지를\n묻습니다.\n핵심 평가지표는 보호해야 할 정보를 놓치지 않고 찾는 재현율입니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_c1_text"
      }
    },
