      "locked": false
    },
    {
      "id": "integrated_code_e_text",
      "type": "text",
      "x": 98,
      "y": 17256,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 813180186,
      "version": 1,
      "versionNonce": 2076424143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "E는 실험을 뜻합니다.\nE0-P는 예비 검증, E0-F는 전체 데이터셋 검증, E1은 기준 시스템 정상 동작\n확인입니다. E2는 탐지, E3는 오류 진단, E4는 사용자 질문, E5는 전체 시스템,\nE6는 가림·복원, E7은 효율성을 평가합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E는 실험을 뜻합니다.\nE0-P는 예비 검증, E0-F는 전체 데이터셋 검증, E1은 기준 시스템 정상 동작\n확인입니다. E2는 탐지, E3는 오류 진단, E4는 사용자 질문, E5는 전체 시스템,\nE6는 가림·복원, E7은 효율성을 평가합니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "integrated_code_c1",
      "type": "rectangle",
      "x": 1032,
      "y": 17238,
