    {
      "id": "src_pipeline_pipeline_intent_text",
      "type": "text",
      "x": 98,
      "y": 6871,
      "width": 568,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 559474066,
      "version": 1,
      "versionNonce": 1929365180,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장의 목적\n민감 정보가 어느 단계에서 관찰되고, 어떤 사실 조건이 정책\n처리 방식으로 바뀌는지 보여 줍니다.\n민감 정보 범위를 잘 찾는 성능과 안전한 전송 경로를 고르는\n성능이 서로 다른 평가 대상임을 분리합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장의 목적\n민감 정보가 어느 단계에서 관찰되고, 어떤 사실 조건이 정책\n처리 방식으로 바뀌는지 보여 줍니다.\n민감 정보 범위를 잘 찾는 성능과 안전한 전송 경로를 고르는\n성능이 서로 다른 평가 대상임을 분리합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_intent_text"
      }
    },
