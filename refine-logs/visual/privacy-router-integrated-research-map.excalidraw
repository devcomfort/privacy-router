      "versionNonce": 709378872,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "연구 단계별 통과 조건 — 현재 G0~G6은 모두 막혀 있습니다.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "연구 단계별 통과 조건 — 현재 G0~G6은 모두 막혀 있습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_gate_title"
      }
    },
    {
      "id": "story_story_gate_0_text_card",
      "type": "rectangle",
      "x": 80,
