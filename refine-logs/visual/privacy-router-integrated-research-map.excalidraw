    {
      "id": "integrated_term_0_0_text",
      "type": "text",
      "x": 98,
      "y": 15809,
      "width": 892,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
