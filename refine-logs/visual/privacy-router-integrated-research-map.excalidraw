      "index": null,
      "seed": 1749136229,
      "version": 1,
      "versionNonce": 1224043818,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2. 정책 P0와 데이터 형식 고정\n가능한 처리 방식을 하나의 고정 목록으로 정하고, 충돌 시 우선순위와 모델 입력·평가 정답의\n분리를 문서화합니다.\n이 작업은 G4 준비에 필요합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. 정책 P0와 데이터 형식 고정\n가능한 처리 방식을 하나의 고정 목록으로 정하고, 충돌 시 우선순위와 모델 입력·평가 정답의\n분리를 문서화합니다.\n이 작업은 G4 준비에 필요합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_action_2_text"
      }
    },
    {
