      "index": null,
      "seed": 1080998659,
      "version": 1,
      "versionNonce": 324080159,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장은 앞에서 사용한 용어를 평범한 말로 다시 설명합니다. 새로운 방법이나 지표 이름을 만드는 장이 아니며, 연구 문서에 이미 있는 개념과 상태를 이해하기 쉽게 정리합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장은 앞에서 사용한 용어를 평범한 말로 다시 설명합니다. 새로운 방법이나 지표 이름을 만드는 장이 아니며, 연구 문서에 이미 있는 개념과 상태를 이해하기 쉽게 정리합니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
