    {
      "id": "src_claim_claim_reading_text",
      "type": "text",
      "x": 726,
      "y": 12610,
      "width": 568,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1916699858,
      "version": 1,
      "versionNonce": 1631577990,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "이 장을 읽는 순서\n먼저 공통 검증과 차단 조건을 확인합니다.\n그다음 C1부터 C7까지 각 패널을 위에서 아래로 읽습니다.\n마지막으로 기준을 못 맞췄을 때 줄여야 할 주장을\n확인합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "이 장을 읽는 순서\n먼저 공통 검증과 차단 조건을 확인합니다.\n그다음 C1부터 C7까지 각 패널을 위에서 아래로 읽습니다.\n마지막으로 기준을 못 맞췄을 때 줄여야 할 주장을\n확인합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_reading_text"
      }
    },
