    {
      "id": "integrated_glossary_intro_text",
      "type": "text",
      "x": 98,
      "y": 15675,
      "width": 1824,
      "height": 23,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
