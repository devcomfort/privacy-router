    {
      "id": "src_story_story_gate_3_text",
      "type": "text",
      "x": 1050,
      "y": 2551,
      "width": 892,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
