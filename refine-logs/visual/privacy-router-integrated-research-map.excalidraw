    {
      "id": "src_story_story_gap_text",
      "type": "text",
      "x": 1050,
      "y": 1300,
      "width": 892,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 574534336,
      "version": 1,
      "versionNonce": 525885715,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2. 기존 평가의 빈틈\n기존 연구가 개인 식별 정보나 개별 작업의 사생활 보호에 주로 초점을 두었는지 확인해야\n합니다.\n조직·연구 기밀의 상태 변화와 수신자·사용 목적을 각각 분리해 평가한 연구가 부족한지는\n선행연구 전문 조사로 검증합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. 기존 평가의 빈틈\n기존 연구가 개인 식별 정보나 개별 작업의 사생활 보호에 주로 초점을 두었는지 확인해야\n합니다.\n조직·연구 기밀의 상태 변화와 수신자·사용 목적을 각각 분리해 평가한 연구가 부족한지는\n선행연구 전문 조사로 검증합니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-research-story.excalidraw:story_gap_text"
