    {
      "id": "integrated_gate_g1_text",
      "type": "text",
      "x": 138,
      "y": 13455,
      "width": 1744,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1043958864,
      "version": 1,
      "versionNonce": 1673492586,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G1 — 예비 검증의 타당성\n목적: 평가자와 문항이 의도한 조건 차이를 안정적으로 구분하는지 확인합니다.\n통과 조건: AC1≥0.67이고, 한 조건만 바꾼 문항의 타당성이 ≥90%여야 합니다.\n필요한 산출물: 80–120개 예비 문항, 평가자 응답, 불일치 분석입니다.\n지금 할 일: 20–30 scenarios × 2 variants × EN/KO를 만들어 맹검 평가합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G1 — 예비 검증의 타당성\n목적: 평가자와 문항이 의도한 조건 차이를 안정적으로 구분하는지 확인합니다.\n통과 조건: AC1≥0.67이고, 한 조건만 바꾼 문항의 타당성이 ≥90%여야 합니다.\n필요한 산출물: 80–120개 예비 문항, 평가자 응답, 불일치 분석입니다.\n지금 할 일: 20–30 scenarios × 2 variants × EN/KO를 만들어 맹검 평가합니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
