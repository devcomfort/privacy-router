      "index": null,
      "seed": 249263004,
      "version": 1,
      "versionNonce": 1333601803,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "안전 우선 중단 규칙(FAIL-CLOSED)\n모델 입력에 평가용 정답 필드가 섞여 있거나 요청 구조가 규칙을 어기면 실행을 거부합니다.\n오류를 무시하고 전송하지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "안전 우선 중단 규칙(FAIL-CLOSED)\n모델 입력에 평가용 정답 필드가 섞여 있거나 요청 구조가 규칙을 어기면 실행을 거부합니다.\n오류를 무시하고 전송하지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-system-pipeline.excalidraw:pipeline_reject_rule_text"
      }
    },
