    {
      "id": "integrated_complete_reading_text",
      "type": "text",
      "x": 1050,
      "y": 402,
      "width": 892,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
