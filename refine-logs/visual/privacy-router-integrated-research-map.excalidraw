    {
      "id": "integrated_gate_g5_text",
      "type": "text",
      "x": 138,
      "y": 14355,
      "width": 1744,
      "height": 113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 2095590597,
      "version": 1,
      "versionNonce": 770305688,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G5 — 본 실험 근거 확보\n목적: C1~C7을 판단할 실제 실험 결과를 만듭니다.\n통과 조건: E2, E3, E5, E6을 완료하고 사전에 정한 주 지표와 통과 기준을 계산해야 합니다.\n필요한 산출물: 원시 예측, 지표, 신뢰구간, 실패 사례, 실행 명세입니다.\n지금 할 일: G0~G4를 모두 통과하기 전에는 본 실험을 시작하지 않습니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G5 — 본 실험 근거 확보\n목적: C1~C7을 판단할 실제 실험 결과를 만듭니다.\n통과 조건: E2, E3, E5, E6을 완료하고 사전에 정한 주 지표와 통과 기준을 계산해야 합니다.\n필요한 산출물: 원시 예측, 지표, 신뢰구간, 실패 사례, 실행 명세입니다.\n지금 할 일: G0~G4를 모두 통과하기 전에는 본 실험을 시작하지 않습니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
