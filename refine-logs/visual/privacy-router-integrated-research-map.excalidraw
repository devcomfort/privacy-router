    {
      "id": "src_pipeline_pipeline_factors_text",
      "type": "text",
      "x": 188,
      "y": 4790,
      "width": 1644,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
