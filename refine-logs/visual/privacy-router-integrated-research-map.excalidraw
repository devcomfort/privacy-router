      "locked": false
    },
    {
      "id": "integrated_term_1_0_text",
      "type": "text",
      "x": 98,
      "y": 15974,
      "width": 892,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1203228171,
      "version": 1,
      "versionNonce": 1258838628,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "정보의 의미 단위(information atom)\n표현이 달라도 같은 민감한 뜻을 전달하는 최소 정보 단위입니다. 원문이 바뀌어도 의미가 남는\n누출을 찾는 데 씁니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "정보의 의미 단위(information atom)\n표현이 달라도 같은 민감한 뜻을 전달하는 최소 정보 단위입니다. 원문이 바뀌어도 의미가 남는\n누출을 찾는 데 씁니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
