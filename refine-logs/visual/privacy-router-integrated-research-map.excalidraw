      "text": "E·C·G 번호를 읽는 방법",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E·C·G 번호를 읽는 방법",
      "autoResize": false,
