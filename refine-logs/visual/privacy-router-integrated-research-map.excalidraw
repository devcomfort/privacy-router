    {
      "id": "integrated_gate_sequence_text",
      "type": "text",
      "x": 98,
      "y": 15274,
      "width": 1824,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 152841634,
      "version": 1,
      "versionNonce": 342088120,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "권장 실행 순서\nG0 전문 조사와 G1 예비 검증을 먼저 진행합니다. 두 결과가 기준을 충족하면 G2 데이터셋과 G3 평가기를 고정하고, 이어서 G4 실행 조건을 잠급니다. 그 뒤에만 G5 본 실험과 G6\n논문 제출 준비로 이동합니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "권장 실행 순서\nG0 전문 조사와 G1 예비 검증을 먼저 진행합니다. 두 결과가 기준을 충족하면 G2 데이터셋과 G3 평가기를 고정하고, 이어서 G4 실행 조건을 잠급니다. 그 뒤에만 G5 본 실험과 G6\n논문 제출 준비로 이동합니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
