    {
      "id": "src_claim_claim_metric_C3_text",
      "type": "text",
      "x": 118,
      "y": 9834,
      "width": 1784,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
