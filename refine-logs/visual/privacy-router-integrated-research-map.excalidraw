    {
      "id": "src_claim_claim_metric_C1_text",
      "type": "text",
      "x": 118,
      "y": 8642,
      "width": 1784,
      "height": 68,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "seed": 1121062565,
      "version": 1,
      "versionNonce": 1459973222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "안전한 내용을 민감하다고 잘못 판단한 비율(safe-FPR)을 같게 맞춘 뒤 재현율 차이를 비교합니다.\n시나리오 묶음 단위 95% 신뢰구간 하한이 0보다 커야 합니다(lower bound > 0).\n실용적 목표는 재현율 차이의 점 추정치가 +10pp인 것입니다.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "안전한 내용을 민감하다고 잘못 판단한 비율(safe-FPR)을 같게 맞춘 뒤 재현율 차이를 비교합니다.\n시나리오 묶음 단위 95% 신뢰구간 하한이 0보다 커야 합니다(lower bound > 0).\n실용적 목표는 재현율 차이의 점 추정치가 +10pp인 것입니다.",
      "autoResize": false,
      "lineHeight": 1.25,
      "customData": {
        "sourceKey": "privacy-router-claim-evidence.excalidraw:claim_metric_C1_text"
      }
    },
