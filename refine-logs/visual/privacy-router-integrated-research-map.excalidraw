    {
      "id": "src_pipeline_pipeline_eval_label",
      "type": "text",
      "x": 98,
      "y": 6045,
      "width": 1824,
      "height": 28,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
