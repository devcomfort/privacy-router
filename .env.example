# Privacy Router — Environment Variables
# Copy for local use: cp .env.example .env

# ── Docker Compose ──────────────────────────────────────────────────────────
DOCKERFILE=Dockerfile
API_PORT=8787
DB_PORT=5433
HERMES_PORT=7860
HERMES_CONFIG=privacy-router
HERMES_UID=10000
HERMES_GID=10000

# ── Database ─────────────────────────────────────────────────────────────────
# The API uses SQLite when DATABASE_URL is unset. Docker Compose injects the
# PostgreSQL URL assembled from these values.
POSTGRES_USER=privacy_router
POSTGRES_PASSWORD=privacy_router
POSTGRES_DB=privacy_router
# DATABASE_URL=sqlite:///privacy_router.db

# ── Privacy Router ───────────────────────────────────────────────────────────
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVACY_ROUTER_MASTER_KEY=<persistent-fernet-key>

# Required for every management API and the /admin UI. Generate once with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PRIVACY_ROUTER_ADMIN_KEY=<random-admin-secret>

# Optional profile override. The workspace active_profile is used when unset.
PRIVACY_ROUTER_PROFILE=default

# Hermes connects to these values inside Docker Compose.
PRIVACY_ROUTER_URL=http://api:8787
# Create one with POST /api/v1/keys, then paste the returned api_key here.
PRIVACY_ROUTER_API_KEY=

# ── Model providers ──────────────────────────────────────────────────────────
# External Model provider fallback. A provider key stored through
# POST /api/providers/{id}/key takes precedence over this environment value.
OPENROUTER_API_KEY=<openrouter-api-key>

# Optional OpenRouter attribution headers.
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_X_TITLE=Privacy Router

# Runtime model roles are configured in .privacy-router.config.yaml and SQLite:
#   decision: local EXAONE 4.0 1.2B at http://127.0.0.1:8010/v1
#   local:    local Gemma 4 26B at http://127.0.0.1:8011/v1
#   external: OpenRouter Gemma 4 26B
# Judge and Router are deterministic code and have no model environment variable.

# Generic low-level agents.llm fallback only; normal routed requests always pass
# the model selected by the active SQLite profile.
# LLM_MODEL=openrouter/google/gemma-4-26b-it

# ── Optional integrations ────────────────────────────────────────────────────
OPENCODE_API_KEY=<opencode-api-key>
OPENCODE_BASE_URL=http://localhost:4096
RELAY_PORT=8789
TELEGRAM_BOT_TOKEN=<telegram-bot-token>

# Repair malformed placeholders in masked model output before hydration.
# Default false: unresolved output remains fail-closed with hydration_failed.
PRIVACY_ROUTER_BETA_PLACEHOLDER_REPAIR=false

# Local inference development helpers.
# HF_CACHE=/home/user/.cache/huggingface
# HF_TOKEN=<hugging-face-token>
