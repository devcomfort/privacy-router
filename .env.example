# Privacy Router — Environment Variables
# Copy for local use: cp .env.example .env

# ── Model Provider API Keys ──────────────────────────────────────────────────
# External LLM provider credentials
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Local Inference Endpoint (Optional) ──────────────────────────────────────
# Base URL for local inference engine (e.g. vLLM, Ollama, SGLang)
LOCAL_API_BASE=http://127.0.0.1:8000/v1

# ── Default Model Selections (Optional) ──────────────────────────────────────
# LLM_MODEL=openrouter/google/gemma-4-26b-it
# EXTRACTOR_MODEL=openrouter/google/gemini-3.1-flash-lite
